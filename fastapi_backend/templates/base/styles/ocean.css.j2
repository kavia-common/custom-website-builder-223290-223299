:root {
  {% for k, v in css_vars.items() %}
  {{ k }}: {{ v }};
  {% endfor %}
}

* { box-sizing: border-box; }
html, body {
  height: 100%;
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-family);
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.25rem;
}

.navbar {
  background: var(--color-surface);
  border-bottom: 1px solid rgba(0,0,0,.06);
  box-shadow: var(--elev-1);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  max-width: 1100px;
  margin: 0 auto;
  padding: .75rem 1.25rem;
}

.brand {
  text-decoration: none;
  color: var(--color-primary);
  font-weight: 700;
}

.nav ul {
  list-style: none;
  display: flex;
  gap: .75rem;
  margin: 0;
  padding: 0;
}

.nav a {
  color: var(--color-text);
  text-decoration: none;
  padding: .4rem .6rem;
  border-radius: .5rem;
  transition: background-color .2s ease, color .2s ease;
}
.nav a:hover {
  background: rgba(37,99,235,.08);
  color: var(--color-primary);
}

.hero {
  background: linear-gradient(135deg, rgba(37,99,235,.08), rgba(0,0,0,0) 60%);
  border-radius: var(--radius-md);
  padding: 2.5rem 1.5rem;
  margin-top: 1rem;
}

.hero h1 {
  margin: 0 0 .5rem 0;
  color: var(--color-primary);
  font-size: 2rem;
}

.subtitle {
  color: rgba(17,24,39,.75);
}

.content {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--elev-1);
  padding: 1.25rem;
  margin: 1.25rem 0 2rem 0;
}

.footer {
  background: var(--color-surface);
  border-top: 1px solid rgba(0,0,0,.06);
  margin-top: 3rem;
}

.footer-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-links {
  list-style: none;
  display: flex;
  gap: .75rem;
  margin: 0;
  padding: 0;
}

.footer a {
  color: var(--color-secondary);
  text-decoration: none;
}
.footer a:hover {
  text-decoration: underline;
}
